# ============================================================
# ClearSky - Inferencia YOLOv8n en Jetson Nano (JetPack 4.6)
# Base: dustynv/l4t-pytorch para L4T r32.7.1 (JetPack 4.6.2)
# IMPORTANTE: El tag DEBE ser compatible con el L4T del host.
# Verificar en la Jetson: cat /etc/nv_tegra_release
# El runtime nvidia monta librerías CUDA/cuDNN/TensorRT del host.
# JetPack 4.6 (r32.6.1) y 4.6.2 (r32.7.1) comparten base L4T r32.x.
# ============================================================
FROM dustynv/l4t-pytorch:r32.7.1

LABEL maintainer="ClearSky Team"
LABEL description="ClearSky YOLOv8n inference with TensorRT on Jetson Nano"

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# La imagen base trae Python 3.6, pero ultralytics 8.x requiere Python >=3.7.
# Instalamos Python 3.8 desde deadsnakes PPA (compatible con Ubuntu 18.04).
# NOTA: En CI con act la red a ports.ubuntu.com puede fallar; en la Jetson real funciona.
RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    && add-apt-repository -y ppa:deadsnakes/ppa \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
    python3.8 python3.8-dev python3.8-distutils python3.8-venv \
    && rm -rf /var/lib/apt/lists/* \
    && update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.8 1 \
    && update-alternatives --install /usr/bin/python python3 /usr/bin/python3.8 1 \
    && curl -sS https://bootstrap.pypa.io/get-pip.py | python3.8

# La imagen base YA incluye: PyTorch, torchvision, TensorRT 7.1.3, CUDA 10.2, cuDNN, OpenCV
# Dependencias de inferencia Python (versiones compatibles con Python 3.8 + aarch64)
# - ultralytics: 8.0.196 (última 8.0.x compatible con Python 3.8)
# - numpy: 1.24.3 (última compatible con Python 3.8)
# - opencv-python-headless: 4.8.1.78 (última con wheel manylinux2014 aarch64)
# - onnxruntime-gpu: ELIMINADO (no hay wheel aarch64+CUDA en PyPI; usar TensorRT nativo)
RUN python3.8 -m pip install --no-cache-dir --upgrade pip setuptools wheel && \
    python3.8 -m pip install --no-cache-dir \
    ultralytics==8.0.196 \
    onnx==1.16.1 \
    opencv-python-headless==4.8.1.78 \
    pyyaml \
    tqdm \
    numpy==1.24.3

WORKDIR /app
COPY src/training/train/test_model.py ./test_model.py
COPY entrypoint.sh ./entrypoint.sh
RUN chmod +x ./entrypoint.sh

# NOTA: weights/best.pt NO se copia aquí; se monta via volume en docker-compose.yml
# para permitir actualizar pesos sin rebuild y evitar incluir binarios en el repo.

EXPOSE 8000
ENTRYPOINT ["/app/entrypoint.sh"]
