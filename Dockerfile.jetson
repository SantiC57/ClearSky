# ============================================================
# ClearSky - Inferencia YOLOv8n en Jetson Nano (JetPack 4.6.1)
# Base: dustynv/l4t-pytorch para L4T r32.6.1 (JetPack 4.6.1)
# PyTorch + TensorRT + CUDA ya incluidos en la imagen
# ============================================================
FROM dustynv/l4t-pytorch:r32.6.1-pth1.10-py3

LABEL maintainer="ClearSky Team"
LABEL description="ClearSky YOLOv8n inference with TensorRT on Jetson Nano"

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# El base ya trae: Python 3.6, PyTorch 1.10, torchvision, TensorRT 7.1.3, CUDA 10.2, cuDNN
# Solo instalamos dependencias extra de inferencia
RUN apt-get update && apt-get install -y --no-install-recommends \
    libglib2.0-0 libsm6 libxext6 libxrender-dev libgl1-mesa-glx \
    git wget curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Dependencias de inferencia (PyTorch y torchvision YA vienen en la imagen base)
RUN pip3 install --no-cache-dir --upgrade pip setuptools wheel && \
    pip3 install --no-cache-dir \
    ultralytics==8.4.115 \
    opencv-python-headless==5.0.0.93 \
    onnx==1.16.1 \
    onnxruntime-gpu==1.18.0 \
    pyyaml \
    tqdm \
    numpy==1.24.3

WORKDIR /app
COPY src/training/train/test_model.py ./test_model.py
COPY weights/best.pt ./weights/best.pt
COPY entrypoint.sh ./entrypoint.sh
RUN chmod +x ./entrypoint.sh

EXPOSE 8000
ENTRYPOINT ["/app/entrypoint.sh"]
