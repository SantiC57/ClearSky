# ============================================================
# ClearSky - Inferencia YOLOv8n en Jetson Nano (JetPack 4.6.1)
# Base: NVIDIA L4T PyTorch 1.13 para L4T 32.6.1 (JetPack 4.6.1)
# ============================================================
FROM nvcr.io/nvidia/l4t-pytorch:r32.6.1-pth1.13-py3

LABEL maintainer="ClearSky Team"
LABEL description="ClearSky YOLOv8n inference with TensorRT on Jetson Nano"

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    LD_LIBRARY_PATH=/usr/lib/aarch64-linux-gnu:/usr/local/cuda/lib64:${LD_LIBRARY_PATH} \
    PATH=/usr/local/cuda/bin:${PATH}

RUN apt-get update && apt-get install -y --no-install-recommends \
    libopencv-dev python3-opencv \
    libglib2.0-0 libsm6 libxext6 libxrender-dev libgl1-mesa-glx \
    tensorrt libnvinfer-dev libnvinfer-plugin-dev \
    git wget curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir --upgrade pip setuptools wheel && \
    pip3 install --no-cache-dir \
    ultralytics==8.4.115 \
    opencv-python-headless==5.0.0.93 \
    onnx==1.16.1 \
    onnxruntime-gpu==1.18.0 \
    pyyaml \
    tqdm \
    numpy==1.24.3

WORKDIR /app
COPY src/training/train/test_model.py ./test_model.py
COPY weights/best.pt ./weights/best.pt
COPY entrypoint.sh ./entrypoint.sh
RUN chmod +x ./entrypoint.sh

EXPOSE 8000
ENTRYPOINT ["/app/entrypoint.sh"]